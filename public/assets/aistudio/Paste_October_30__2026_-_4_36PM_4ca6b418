// ----------------------------------------------------------------------------
// الصفحة الثانية: حاسبة الاستدراك (Rattrapage Flagship Tool)
// ----------------------------------------------------------------------------
export const RattrapagePage: React.FC = () => {
  const [subjects, setSubjects] = useState<Subject[]>(DEFAULT_MIDDLE_2AM_SUBJECTS);
  const [passingThreshold, setPassingThreshold] = useState<number>(10.0);
  const [copied, setCopied] = useState(false);

  // المواد التي تحتاج إلى استدراك (معدلها أقل من 10/20)
  const rattrapageSubjects = useMemo(() => {
    return subjects.map(s => {
      const originalAvg = CalculationService.calculateSubjectAverage(s) ?? 0;
      return {
        ...s,
        originalAvg: Math.round(originalAvg * 100) / 100,
        needsRattrapage: originalAvg < 10
      };
    });
  }, [subjects]);

  // الحساب بعد الاستدراك
  const calculationResults = useMemo(() => {
    let originalTotalPoints = 0;
    let newTotalPoints = 0;
    let totalCoef = 0;

    for (const sub of rattrapageSubjects) {
      originalTotalPoints += sub.originalAvg * sub.coef;
      // في الاستدراك: تؤخذ العلامة الأفضل بين الأصلية والاستدراكية
      const rattrapageMark = sub.rattrapage !== undefined ? sub.rattrapage : sub.originalAvg;
      const effectiveMark = Math.max(sub.originalAvg, rattrapageMark);
      newTotalPoints += effectiveMark * sub.coef;
      totalCoef += sub.coef;
    }

    const originalAvg = totalCoef > 0 ? originalTotalPoints / totalCoef : 0;
    const newAvg = totalCoef > 0 ? newTotalPoints / totalCoef : 0;

    return {
      originalAvg: Math.round(originalAvg * 100) / 100,
      newAvg: Math.round(newAvg * 100) / 100,
      gain: Math.round((newAvg - originalAvg) * 100) / 100,
      isPassed: newAvg >= passingThreshold,
      totalCoef
    };
  }, [rattrapageSubjects, passingThreshold]);

  const handleRattrapageChange = (id: string, val: number) => {
    setSubjects(prev => prev.map(s => s.id === id ? { ...s, rattrapage: val } : s));
  };

  const handleCopy = () => {
    const text = `نتيجتي في حاسبة الاستدراك عبر موقع معدل DZ:\nالمعدل السابق: ${calculationResults.originalAvg}/20\nالمعدل الجديد بعد الاستدراك: ${calculationResults.newAvg}/20\nفارق التحسين: +${calculationResults.gain} نقطة\nالنتيجة: ${calculationResults.isPassed ? 'ناجح بحول الله' : 'يحتاج إلى نقاط إضافية'}`;
    navigator.clipboard.writeText(text);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <div className="space-y-6">
      <div className="border-b border-slate-200 pb-4">
        <span className="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full inline-block mb-2">
          ميزة حصرية ومحدثة لعام 2026/2027
        </span>
        <h1 className="text-xl md:text-3xl font-black text-slate-800 mb-2">
          حاسبة معدل الاستدراك في الجزائر 2026/2027
        </h1>
        <p className="text-xs md:text-sm text-slate-600 leading-relaxed">
          حاكي نقاطك في الامتحان الاستدراكي فورياً واكتشف تأثير كل علامة على معدلك السنوي العام وفق قاعدة احتساب العلامة الأفضل لصالح التلميذ.
        </p>
      </div>

      {/* لوحة النتائج العلوية */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="p-4 rounded-xl bg-white border border-slate-200">
          <span className="text-xs text-slate-500 block mb-1">المعدل قبل الاستدراك</span>
          <span className="text-2xl font-black text-slate-800">{calculationResults.originalAvg}</span>
          <span className="text-xs text-slate-400 mr-1">/ 20</span>
        </div>

        <div className={`p-4 rounded-xl border ${calculationResults.isPassed ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : 'bg-amber-50 border-amber-200 text-amber-900'}`}>
          <span className="text-xs block mb-1 font-medium">المعدل المتوقع بعد الاستدراك</span>
          <div className="flex items-baseline gap-1">
            <span className="text-2xl font-black">{calculationResults.newAvg}</span>
            <span className="text-xs mr-1">/ 20</span>
