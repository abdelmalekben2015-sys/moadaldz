// الدوال الحسابية الخالصة
export const CalculationService = {
  clampMark(val: number | undefined): number | undefined {
    if (val === undefined || isNaN(val)) return undefined;
    if (val < 0) return 0;
    if (val > 20) return 20;
    return Math.round(val * 100) / 100;
  },

  calculateSubjectAverage(subj: Subject): number | undefined {
    if (subj.exam === undefined) return undefined;

    const exam = Math.max(0, Math.min(20, subj.exam));
    const assessment = subj.hasAssessment ? Math.max(0, Math.min(20, subj.assessment ?? 10)) : 0;
    const test1 = Math.max(0, Math.min(20, subj.test1 ?? 10));

    if (subj.hasAssessment) {
      if (subj.hasTest2 && subj.test2 !== undefined) {
        const test2 = Math.max(0, Math.min(20, subj.test2));
        const testsAvg = (test1 + test2) / 2;
        return (assessment + testsAvg + exam * 2) / 4;
      }
      return (assessment + test1 + exam * 2) / 4;
    } else {
      // للمواد بدون تقويم مستمر
      return (test1 + exam * 2) / 3;
    }
  },

  calculateTotalTrimestre(subjects: Subject[]): {
    average: number;
    totalWeightedPoints: number;
    totalCoef: number;
    completedCount: number;
    hasEmptyMarks: boolean;
  } {
    let totalPoints = 0;
    let totalCoef = 0;
    let completedCount = 0;
    let hasEmptyMarks = false;

    for (const sub of subjects) {
      const avg = this.calculateSubjectAverage(sub);
      if (avg !== undefined) {
        totalPoints += avg * sub.coef;
        totalCoef += sub.coef;
        completedCount++;
      } else {
        hasEmptyMarks = true;
      }
    }

    const average = totalCoef > 0 ? totalPoints / totalCoef : 0;
    return {
      average: Math.round(average * 100) / 100,
      totalWeightedPoints: Math.round(totalPoints * 100) / 100,
      totalCoef,
      completedCount,
      hasEmptyMarks
    };
  },

  calculateRequiredExamMark(params: {
    targetAverage: number;
    currentAverageExcludingSubject: number;
    sumCoefsOther: number;
    targetSubjectCoef: number;
    assessmentMark: number;
    testMark: number;
  }): { requiredExam: number; isPossible: boolean; message: string } {
    const { targetAverage, currentAverageExcludingSubject, sumCoefsOther, targetSubjectCoef, assessmentMark, testMark } = params;
    const totalCoef = sumCoefsOther + targetSubjectCoef;
    const requiredTotalPoints = targetAverage * totalCoef;
    const currentPointsFromOthers = currentAverageExcludingSubject * sumCoefsOther;
    const neededSubjectPoints = requiredTotalPoints - currentPointsFromOthers;
    const neededSubjectAverage = neededSubjectPoints / targetSubjectCoef;

    // معدل المادة = (التقويم + الفرض + الاختبار × 2) ÷ 4
    // إذن: الاختبار × 2 = (معدل المادة × 4) - التقويم - الفرض
    const requiredExam = ((neededSubjectAverage * 4) - assessmentMark - testMark) / 2;
    const roundedExam = Math.round(requiredExam * 100) / 100;

    if (roundedExam <= 0) {
      return {
        requiredExam: 0,
        isPossible: true,
        message: "أنت لا تحتاج إلى أي علامة إضافية في الاختبار لتحقيق هذا الهدف؛ رصيدك الحالي كافٍ."
      };
    }
    if (roundedExam > 20) {
      return {
        requiredExam: roundedExam,
        isPossible: false,
        message: `الهدف غير ممكن نظرياً؛ يتطلب علامة ${roundedExam}/20 في الاختبار وهي تتجاوز الحد الأقصى 20.`
      };
    }
    return {
      requiredExam: roundedExam,
      isPossible: true,
      message: `تحتاج إلى علامة لا تقل عن ${roundedExam}/20 في الاختبار لتحقيق المعدل المطلوب.`
    };
  }
};

