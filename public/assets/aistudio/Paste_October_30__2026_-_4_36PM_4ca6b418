// الصفحة الخامسة: حاسبة المعدل الجامعي LMD
// ----------------------------------------------------------------------------
export const UniversityPage: React.FC = () => {
  const [modules, setModules] = useState<UniversityModule[]>(DEFAULT_UNIVERSITY_MODULES);

  const updateModuleMark = (id: string, field: 'td' | 'exam', val: number | undefined) => {
    setModules(prev => prev.map(m => m.id === id ? { ...m, [field]: val } : m));
  };

  const results = useMemo(() => {
    let totalPoints = 0;
    let totalCoef = 0;
    let acquiredCredits = 0;
    let totalCredits = 0;

    for (const mod of modules) {
      const td = mod.td ?? 10;
      const exam = mod.exam ?? 10;
      const modAvg = (td * 0.4) + (exam * 0.6);
      totalPoints += modAvg * mod.coef;
      totalCoef += mod.coef;
      totalCredits += mod.credits;

      if (modAvg >= 10) {
        acquiredCredits += mod.credits;
      }
    }

    const semesterAvg = totalCoef > 0 ? totalPoints / totalCoef : 0;
    const roundedAvg = Math.round(semesterAvg * 100) / 100;

    // في حال نجاح السداسي بمعدل 10/20 فما فوق، تُكتسب جميع الأرصدة (30 رصيداً) بالتعويض
    const finalCredits = roundedAvg >= 10 ? totalCredits : acquiredCredits;

    return {
      semesterAvg: roundedAvg,
      totalCredits,
      finalCredits,
      isSemesterPassed: roundedAvg >= 10
    };
  }, [modules]);

  return (
    <div className="space-y-6">
      <div className="border-b border-slate-200 pb-4">
        <h1 className="text-xl md:text-3xl font-black text-slate-800 mb-2">
          حاسبة المعدل الجامعي ونظام الأرصدة LMD
        </h1>
        <p className="text-xs md:text-sm text-slate-600">
          حساب معدل المقاييس، معدل السداسي، ورصيد الوحدات وفق قاعدة التعويض المعمول بها في الجامعات الجزائرية.
        </p>
      </div>

      <div className="bg-indigo-900 text-white p-5 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <span className="text-xs text-indigo-200 block mb-1">المعدل العام للسداسي</span>
          <div className="flex items-baseline gap-2">
            <span className="text-4xl font-black">{results.semesterAvg}</span>
            <span className="text-sm opacity-80">/ 20</span>
          </div>
        </div>
        <div className="bg-indigo-800/80 p-3 rounded-xl text-xs space-y-1">
          <p>الأرصدة المكتسبة: <strong>{results.finalCredits} من {results.totalCredits}</strong></p>
          <p>الوضعية: <strong>{results.isSemesterPassed ? 'سداسي مكتسب بالتعويض' : 'استدراك مطلوب للمقاييس غير المكتسبة'}</strong></p>
        </div>
      </div>

      <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div className="overflow-x-auto">
          <table className="w-full text-right text-xs">
            <thead className="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold">
              <tr>
                <th className="p-3">المقياس</th>
                <th className="p-3">المعامل</th>
                <th className="p-3">الأرصدة</th>
                <th className="p-3">التقييم المستمر (TD)</th>
                <th className="p-3">امتحان السداسي</th>
                <th className="p-3">معدل المقياس</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {modules.map((m) => {
                const td = m.td ?? 0;
                const exam = m.exam ?? 0;
                const avg = Math.round(((td * 0.4) + (exam * 0.6)) * 100) / 100;
                return (
                  <tr key={m.id}>
                    <td className="p-3 font-bold text-slate-800">{m.name}</td>
                    <td className="p-3 text-slate-500">{m.coef}</td>
                    <td className="p-3 text-slate-500">{m.credits}</td>
                    <td className="p-3">
                      <input
                        type="number"
                        min="0"
                        max="20"
                        step="0.25"
                        value={m.td ?? ''}
                        onChange={(e) => updateModuleMark(m.id, 'td', e.target.value ? parseFloat(e.target.value) : undefined)}
                        className="w-16 p-1 border border-slate-200 rounded text-center"
                      />
                    </td>
                    <td className="p-3">
                      <input
                        type="number"
                        min="0"
                        max="20"
                        step="0.25"
                        value={m.exam ?? ''}
                        onChange={(e) => updateModuleMark(m.id, 'exam', e.target.value ? parseFloat(e.target.value) : undefined)}
                        className="w-16 p-1 border border-slate-200 rounded text-center"
                      />
                    </td>
                    <td className={`p-3 font-bold ${avg >= 10 ? 'text-emerald-600' : 'text-amber-600'}`}>
                      {avg}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};

