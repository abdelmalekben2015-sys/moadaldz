    document.title = title;

    // تحديث الوسوم التعريفية
    const setMeta = (name: string, content: string) => {
      let meta = document.querySelector(`meta[name="${name}"]`);
      if (!meta) {
        meta = document.createElement('meta');
        meta.setAttribute('name', name);
        document.head.appendChild(meta);
      }
      meta.setAttribute('content', content);
    };

    setMeta('description', desc);
    setMeta('robots', 'index, follow');

    // Canonical Tag
    let canonical = document.querySelector('link[rel="canonical"]');
    if (!canonical) {
      canonical = document.createElement('link');
      canonical.setAttribute('rel', 'canonical');
      document.head.appendChild(canonical);
    }
    canonical.setAttribute('href', `${APP_CONFIG.canonicalDomain}${path === '/' ? '' : path}`);

    // تمرير رمز تحقق Google Search Console إذا توفر
    if (APP_CONFIG.googleSearchConsoleVerification) {
      setMeta('google-site-verification', APP_CONFIG.googleSearchConsoleVerification);
    }
  }, [path]);

  return null;
};

